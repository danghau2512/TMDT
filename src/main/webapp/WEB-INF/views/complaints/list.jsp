<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layouts/shop-start.jspf" %>
<div class="feature-heading"><div><p class="eyebrow">Đồng hành sau giao dịch</p><h1>${complaintAdmin ? 'Trung tâm khiếu nại' : 'Khiếu nại của tôi'}</h1><p>${complaintAdmin ? 'Tiếp nhận phản ánh, đối chiếu bằng chứng và phản hồi người mua.' : 'Theo dõi phản ánh theo đơn hàng và trao đổi với Admin ngay tại đây.'}</p></div><span class="feature-icon" aria-hidden="true">☷</span></div>
<div class="complaint-stats"><c:set var="statsKeys" value="${['total','received','processing','resolved']}" /><c:set var="statsCodes" value="${['','RECEIVED','PROCESSING','RESOLVED']}" /><c:forEach begin="0" end="3" var="i"><c:set var="code" value="${statsCodes[i]}" /><a class="stat-link" data-status="${code}" href="<c:url value='${complaintBase}'><c:param name='status' value='${code}' /></c:url>" ${param.status == code or (empty param.status and i == 0) ? 'aria-current="page"' : ''}><span class="stat-dot" aria-hidden="true"></span><div><strong>${complaintStats[statsKeys[i]]}</strong><small>${i == 0 ? 'Tất cả hồ sơ' : feedbackLabels[code]}</small></div></a></c:forEach></div>
<form method="get" action="<c:url value='${complaintBase}' />" class="filter-bar"><label>Trạng thái<select name="status"><option value="">Tất cả</option><c:forTokens items="RECEIVED,PROCESSING,RESOLVED" delims="," var="code"><option value="${code}" ${param.status == code ? 'selected' : ''}>${feedbackLabels[code]}</option></c:forTokens></select></label><c:if test="${complaintAdmin}"><label>Mã đơn<input name="query" maxlength="100" placeholder="Nhập mã hoặc một phần mã đơn" value="<c:out value='${param.query}' />"></label></c:if><button>Lọc hồ sơ</button><a href="<c:url value='${complaintBase}' />">Bỏ lọc</a></form>
<c:choose><c:when test="${empty complaints}"><section class="empty-state"><span class="feature-icon" aria-hidden="true">☷</span><h2>Chưa có hồ sơ phù hợp</h2><p>${complaintAdmin ? 'Hồ sơ mới của người mua sẽ xuất hiện tại đây. Hãy thử bỏ bộ lọc.' : 'Bạn có thể gửi phản ánh từ trang chi tiết đơn mua khi cần hỗ trợ.'}</p><a class="button" href="<c:url value='${complaintAdmin ? "/admin/orders" : "/buyer/orders"}' />">Xem đơn hàng</a></section></c:when><c:otherwise><div class="complaint-cards"><c:forEach items="${complaints}" var="c"><article class="complaint-card"><div class="card-top"><span class="eyebrow">Hồ sơ #${c.id}</span><span class="badge" data-status="${c.status}">${feedbackLabels[c.status]}</span></div><div class="case-product"><c:choose><c:when test="${not empty c.image_id}"><img src="<c:url value='/media/order-image'><c:param name='orderId' value='${c.order_id}' /><c:param name='asset' value='${c.image_id}' /></c:url>" alt="Sản phẩm khi đặt hàng"></c:when><c:otherwise><img src="<c:url value='/assets/images/product-placeholder.svg' />" alt="Chưa có ảnh"></c:otherwise></c:choose><div><h2><c:out value="${c.product_name}" default="Sản phẩm trong đơn" /></h2><p><c:out value="${c.title}" /></p><span class="order-reference">Đơn <c:out value="${c.order_code}" /></span></div></div><c:if test="${complaintAdmin}"><small>Người mua: <c:out value="${c.buyer_name_snapshot}" /> · Người bán: <c:out value="${c.seller_name_snapshot}" /></small></c:if><div class="card-bottom"><small>Ngày gửi<br><time data-local-time><c:out value="${c.created_at}" /></time></small><a class="button secondary" href="<c:url value='${complaintBase}/detail'><c:param name='id' value='${c.id}' /></c:url>">Xem chi tiết →</a></div></article></c:forEach></div><p class="condition-note">Hiển thị tối đa 200 hồ sơ mới cập nhật; các thẻ tổng quan tính toàn bộ hồ sơ trong phạm vi tài khoản.</p></c:otherwise></c:choose>
<%@ include file="../layouts/shop-end.jspf" %>
