<%@ page pageEncoding="UTF-8" %>
<div class="condition-panel"><h2><span aria-hidden="true">◈</span> Tình trạng sản phẩm</h2><p class="condition-note">Thông tin do người bán khai báo · Hãy trao đổi thêm trước khi mua.</p>
<dl class="condition-grid"><div class="condition-value"><dt>Ngoại hình</dt><dd><c:out value="${conditionLabels[product.appearance_code]}" default="Chưa cung cấp" /></dd></div><div class="condition-value"><dt>Khả năng hoạt động</dt><dd><c:out value="${conditionLabels[product.operation_code]}" default="Chưa cung cấp" /></dd></div><div class="condition-value"><dt>Lịch sử sửa chữa</dt><dd><c:out value="${conditionLabels[product.repair_code]}" default="Chưa cung cấp" /></dd></div></dl>
<div class="declared-defects"><h3>⚑ Lỗi hoặc khuyết điểm đã biết</h3><p class="preserve"><c:out value="${product.known_defects}" default="Chưa cung cấp" /></p></div>
<dl class="condition-grid"><div class="condition-value"><dt>Sửa chữa / thay linh kiện</dt><dd class="preserve"><c:out value="${product.repair_details}" default="Chưa cung cấp" /></dd></div><div class="condition-value"><dt>Phụ kiện đi kèm</dt><dd class="preserve"><c:out value="${product.accessories}" default="Chưa cung cấp" /></dd></div></dl>
<div class="defect-gallery"><c:forEach items="${images}" var="photo"><c:if test="${photo.is_defect}"><figure><c:url var="defectUrl" value="/media/product"><c:param name="asset" value="${photo.asset_id}" /></c:url><a href="${defectUrl}" aria-label="Xem ảnh khuyết điểm lớn"><img src="${defectUrl}" alt="Khuyết điểm do người bán khai báo"></a><figcaption>Ảnh khuyết điểm</figcaption></figure></c:if></c:forEach></div></div>
