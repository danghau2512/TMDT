<%@ page pageEncoding="UTF-8" %>
<section id="reviews"><p class="eyebrow">Trải nghiệm từ người mua</p><h2>Đánh giá xác nhận mua hàng</h2><div class="review-summary"><div><div class="review-score"><fmt:formatNumber value="${ratingSummary.average_rating}" maxFractionDigits="1" minFractionDigits="1" /><small>/5</small></div><p class="review-stars" aria-label="Điểm trung bình"><c:forEach begin="1" end="5" var="s">${s <= ratingSummary.average_rating ? '★' : '☆'}</c:forEach></p><small><c:out value="${ratingSummary.review_count}" /> đánh giá công khai</small></div><div class="rating-bars"><c:forEach begin="1" end="5" var="n"><c:set var="star" value="${6-n}" /><c:set var="starKey" value="stars${star}" /><div class="rating-bar"><span>${star} ★</span><progress max="${ratingSummary.review_count == 0 ? 1 : ratingSummary.review_count}" value="${ratingSummary[starKey]}" aria-label="${star} sao: ${ratingSummary[starKey]} đánh giá"></progress><span>${ratingSummary[starKey]}</span></div></c:forEach></div></div>
<div class="review-filter" aria-label="Lọc đánh giá"><a href="<c:url value='/products/detail'><c:param name='id' value='${product.id}' /></c:url>#reviews" ${empty param.stars and param.photos != 'true' ? 'aria-current="true"' : ''}>Tất cả</a><c:forEach begin="1" end="5" var="n"><c:set var="star" value="${6-n}" /><a href="<c:url value='/products/detail'><c:param name='id' value='${product.id}' /><c:param name='stars' value='${star}' /></c:url>#reviews" ${param.stars == star.toString() ? 'aria-current="true"' : ''}>${star} ★</a></c:forEach><a href="<c:url value='/products/detail'><c:param name='id' value='${product.id}' /><c:param name='photos' value='true' /></c:url>#reviews" ${param.photos == 'true' ? 'aria-current="true"' : ''}>▧ Có hình ảnh</a></div>
<c:if test="${empty productReviews}"><div class="empty-state"><h3>${ratingSummary.review_count == 0 ? 'Chưa có đánh giá' : 'Chưa có đánh giá phù hợp bộ lọc'}</h3><p>Người mua có thể chia sẻ trải nghiệm sau khi đơn hoàn thành.</p></div></c:if>
<c:forEach items="${productReviews}" var="review"><article class="review-entry"><header><div class="review-person"><span class="review-avatar" aria-hidden="true"><c:out value="${fn:substring(review.reviewer_name,0,1)}" /></span><div><strong><c:out value="${review.reviewer_name}" /></strong><br><time data-local-time><c:out value="${review.created_at}" /></time></div></div><span class="verified-badge">✓ Đã mua qua hệ thống</span></header><p class="review-stars" aria-label="${review.product_rating} trên 5 sao"><c:forEach begin="1" end="5" var="s">${s <= review.product_rating ? '★' : '☆'}</c:forEach></p><p class="preserve"><c:out value="${review.comment}" /></p><div class="review-gallery"><c:forEach items="${review.photos}" var="photo"><c:url var="reviewImage" value="/media/review-image"><c:param name="reviewId" value="${review.id}" /><c:param name="asset" value="${photo.asset_id}" /></c:url><a href="${reviewImage}" aria-label="Phóng to ảnh thực tế từ người mua"><img src="${reviewImage}" alt="Ảnh thực tế từ người mua"></a></c:forEach></div></article></c:forEach>
<c:if test="${reviewPages > 1}"><nav class="pagination" aria-label="Trang đánh giá"><c:if test="${reviewPage > 1}"><a href="<c:url value='/products/detail'><c:param name='id' value='${product.id}' /><c:param name='stars' value='${param.stars}' /><c:param name='photos' value='${param.photos}' /><c:param name='reviewPage' value='${reviewPage-1}' /></c:url>#reviews">← Trước</a></c:if><span>Trang ${reviewPage} / ${reviewPages}</span><c:if test="${reviewPage < reviewPages}"><a href="<c:url value='/products/detail'><c:param name='id' value='${product.id}' /><c:param name='stars' value='${param.stars}' /><c:param name='photos' value='${param.photos}' /><c:param name='reviewPage' value='${reviewPage+1}' /></c:url>#reviews">Tiếp →</a></c:if></nav></c:if></section>
