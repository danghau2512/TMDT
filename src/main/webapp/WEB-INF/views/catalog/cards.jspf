<%@ page pageEncoding="UTF-8" %>
<c:if test="${empty products}"><section class="empty-state"><h2>Chưa tìm thấy món đồ phù hợp</h2><p>Thử từ khóa ngắn hơn, đổi danh mục hoặc mở rộng khoảng giá.</p><a class="button secondary" href="<c:url value='/products' />">Xem tất cả sản phẩm</a></section></c:if>
<div class="product-grid"><c:forEach var="p" items="${products}"><article class="product-card">
<c:url var="detailUrl" value="/products/detail"><c:param name="id" value="${p.id}" /></c:url>
<a href="${detailUrl}" class="image-link"><c:choose><c:when test="${not empty p.image_id}"><c:url var="imageUrl" value="/media/product"><c:param name="asset" value="${p.image_id}" /></c:url><img src="${imageUrl}" alt="<c:out value='${p.title}' />" loading="lazy"></c:when><c:otherwise><img src="<c:url value='/assets/images/product-placeholder.svg' />" alt="Người bán chưa thêm ảnh" loading="lazy"></c:otherwise></c:choose><c:if test="${p.stock_quantity == 0}"><span class="stock-tag">Hết hàng</span></c:if></a>
<div class="card-body"><p class="muted"><c:out value="${p.category_name}" /> · <c:out value="${labels[p.condition_code]}" /></p><h3><a href="${detailUrl}"><c:out value="${p.title}" /></a></h3><p class="price"><fmt:formatNumber value="${p.price}" pattern="#,##0" /> ₫</p><p class="muted card-meta"><svg class="icon" aria-hidden="true"><use href="#i-user" /></svg><c:out value="${p.seller_name}" /></p><button type="button" class="compare-toggle" data-compare-id="${p.id}" data-compare-category="${p.category_id}" aria-pressed="false">⇄ So sánh</button></div></article></c:forEach></div>
