<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty attempts}"><section class="payment-attempts"><h2>Các lần thanh toán VNPAY Sandbox</h2><div class="table-wrap"><table><thead><tr><th>Lần thanh toán</th><th>Số tiền</th><th>Kết quả</th><th>Thông tin gateway</th><th></th></tr></thead><tbody>
<c:forEach items="${attempts}" var="a"><tr><td><code class="txn-ref"><c:out value="${a.txn_ref}" /></code><br><small><c:out value="${a.created_at}" /></small></td><td><fmt:formatNumber value="${a.expected_amount}" pattern="#,##0" /> ₫</td><td><span class="badge" data-status="${a.status}">${gatewayLabels[a.status]}</span></td><td><c:out value="${a.gateway_transaction_no}" default="Chưa xác nhận" /><br><small><c:out value="${a.bank_code}" /> · <c:out value="${a.gateway_pay_date}" /><br>Mã phản hồi: <c:out value="${a.response_code}" default="—" /> / trạng thái: <c:out value="${a.transaction_status}" default="—" /></small></td><td><c:if test="${orderView == 'buyer' or empty orderView}"><a href="<c:url value='/payments/vnpay/result'><c:param name='ref' value='${a.txn_ref}' /></c:url>">Xem kết quả</a></c:if></td></tr></c:forEach>
</tbody></table></div></section></c:if>
