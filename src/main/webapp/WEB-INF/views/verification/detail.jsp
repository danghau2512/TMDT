<%@ page pageEncoding="UTF-8" %><%@ include file="../layouts/shop-start.jspf" %><%@ include file="tags.jspf" %>
<p><a href="<c:url value='/admin/verifications?status=PENDING' />">← Danh sách hồ sơ</a></p><div class="page-heading"><h1>Đối chiếu hồ sơ #${submission.id}</h1><span class="badge" data-status="${submission.status}"><c:out value="${verificationLabels[submission.status]}" /></span></div>
<c:choose><c:when test="${not submission.canView}"><section class="empty-state"><svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg><h2>Giấy tờ chỉ dành cho người phụ trách</h2><c:choose><c:when test="${submission.claimable}"><p>Nhận xử lý để xem ảnh, thông tin đã gửi và kết quả đọc ban đầu.</p><form method="post" action="<c:url value='/admin/verifications/claim' />"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />"><input type="hidden" name="id" value="${submission.id}"><button>Nhận xử lý hồ sơ</button></form></c:when><c:otherwise><p>Hồ sơ này đã có quản trị viên khác phụ trách.</p></c:otherwise></c:choose></section></c:when><c:otherwise>
<div class="verification-review"><section><h2>Giấy tờ đã gửi</h2><%@ include file="images.jspf" %><p class="muted">Đối chiếu trực tiếp với thông tin ở bên cạnh. Không chụp hoặc chia sẻ giấy tờ thật trong báo cáo.</p></section><section><h2>Thông tin người dùng xác nhận</h2><p class="verification-source"><strong>Nguồn:</strong> <c:out value="${submission.sourceLabel}" /></p><dl class="verification-values"><c:forEach var="field" items="${submission.fields}"><dt><c:out value="${field.label}" /></dt><dd><c:out value="${empty field.value ? 'Chưa có thông tin (hồ sơ cũ)' : field.value}" /></dd></c:forEach><dt>Gửi lúc</dt><dd><c:out value="${submission.submitted_at}" /></dd></dl>
<c:choose><c:when test="${submission.hasBaseline}"><div class="verification-qr-original"><h3>${submission.legacy ? 'Thông tin đọc ban đầu (hồ sơ cũ)' : 'Thông tin đọc từ QR'}</h3><c:forEach var="field" items="${submission.fields}"><c:if test="${not empty field.original}"><p><strong><c:out value="${field.label}" />:</strong> <c:out value="${field.original}" /> <c:if test="${field.changed}"><span class="verification-edited">Người dùng đã sửa</span></c:if></p></c:if></c:forEach><p class="muted">Kết quả đọc chỉ hỗ trợ đối chiếu, không phải quyết định xác minh.</p></div></c:when><c:otherwise><p class="notice">Hồ sơ nhập thủ công. Cần đối chiếu đầy đủ ảnh và thông tin trước khi quyết định.</p></c:otherwise></c:choose>
<c:choose><c:when test="${submission.status == 'PENDING'}"><form class="account-form verification-decision" method="post" action="<c:url value='/admin/verifications/decide' />"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />"><input type="hidden" name="id" value="${submission.id}"><label>Lý do nếu từ chối<textarea name="reason" maxlength="1000" rows="3" placeholder="Nêu rõ điểm cần bổ sung để người dùng gửi lại"></textarea></label><div class="actions"><button name="action" value="APPROVE">✓ Chấp thuận hồ sơ</button><button class="danger" name="action" value="REJECT">Từ chối &amp; yêu cầu bổ sung</button></div></form></c:when><c:otherwise><p>Đã xử lý lúc <c:out value="${submission.reviewed_at}" /></p><c:if test="${not empty submission.rejection_reason}"><p class="verification-reason"><c:out value="${submission.rejection_reason}" /></p></c:if></c:otherwise></c:choose>
</section></div></c:otherwise></c:choose><%@ include file="../layouts/shop-end.jspf" %>
