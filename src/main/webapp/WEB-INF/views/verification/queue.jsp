<%@ page pageEncoding="UTF-8" %><%@ include file="../layouts/shop-start.jspf" %><%@ include file="tags.jspf" %>
<div class="page-heading"><div><p class="eyebrow">Đối chiếu giấy tờ · quyền đăng tin</p><h1>Hồ sơ người bán</h1><p>Nhận xử lý hồ sơ trước khi xem thông tin và ảnh riêng tư.</p></div></div>
<form class="filter-bar" method="get"><label>Trạng thái<select name="status"><option value="">Tất cả hồ sơ đã gửi</option><c:forEach var="code" items="${['PENDING','APPROVED','REJECTED']}"><option value="${code}" ${param.status == code ? 'selected' : ''}><c:out value="${verificationLabels[code]}" /></option></c:forEach></select></label><button>Lọc hồ sơ</button></form>
<c:if test="${empty verificationQueue}"><section class="empty-state"><h2>Chưa có hồ sơ trong nhóm này</h2><p>Hồ sơ mới gửi sẽ xuất hiện ở mục Chờ duyệt.</p></section></c:if>
<div class="verification-queue"><c:forEach var="v" items="${verificationQueue}"><section><div class="section-heading"><h2><c:out value="${v.display_name}" /></h2><span class="badge" data-status="${v.status}"><c:out value="${verificationLabels[v.status]}" /></span></div><p>Hồ sơ #${v.id} · Gửi: <c:out value="${v.submitted_at}" /></p><p class="muted">${empty v.reviewer_id ? 'Chưa có quản trị viên phụ trách' : 'Đã có quản trị viên phụ trách'}</p><a class="button secondary" href="<c:url value='/admin/verifications/detail'><c:param name='id' value='${v.id}' /></c:url>">Xem hồ sơ →</a></section></c:forEach></div>
<nav class="pagination"><c:if test="${queuePage > 1}"><a href="<c:url value='/admin/verifications'><c:param name='page' value='${queuePage-1}' /><c:param name='status' value='${param.status}' /></c:url>">← Trước</a></c:if><span>Trang ${queuePage}</span><c:if test="${fn:length(verificationQueue) == 20}"><a href="<c:url value='/admin/verifications'><c:param name='page' value='${queuePage+1}' /><c:param name='status' value='${param.status}' /></c:url>">Tiếp →</a></c:if></nav>
<%@ include file="../layouts/shop-end.jspf" %>
