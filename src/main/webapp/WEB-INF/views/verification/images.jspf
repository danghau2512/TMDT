<%@ page pageEncoding="UTF-8" %>
<div class="verification-documents"><c:if test="${submission.hasFront}"><figure><img src="<c:url value='/seller/verification/image'><c:param name='id' value='${submission.id}' /><c:param name='side' value='front' /></c:url>" alt="Giấy tờ mặt trước riêng tư"><figcaption>Mặt trước</figcaption></figure></c:if><c:if test="${submission.hasBack}"><figure><img src="<c:url value='/seller/verification/image'><c:param name='id' value='${submission.id}' /><c:param name='side' value='back' /></c:url>" alt="Giấy tờ mặt sau riêng tư"><figcaption>Mặt sau</figcaption></figure></c:if></div>
