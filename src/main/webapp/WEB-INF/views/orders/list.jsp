<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layouts/shop-start.jspf" %>
<section><p class="eyebrow">${orderView == 'buyer' ? 'Mua hàng' : orderView == 'seller' ? 'Bán hàng' : 'Quản trị'}</p><h1>${orderView == 'buyer' ? 'Đơn mua của tôi' : orderView == 'seller' ? 'Đơn bán của tôi' : 'Quản lý đơn hàng'}</h1>
<form method="get" action="<c:url value='${orderBase}' />" class="filter-bar"><label>Trạng thái <select name="status"><option value="">Tất cả</option><c:forTokens items="PENDING,CONFIRMED,SHIPPED,DELIVERED,COMPLETED,CANCELLED" delims="," var="state"><option value="${state}" ${param.status == state ? 'selected' : ''}>${labels[state]}</option></c:forTokens></select></label><button>Lọc đơn</button></form>
<c:if test="${empty orders}"><p class="empty-state">Chưa có đơn hàng phù hợp.</p></c:if>
<c:choose><c:when test="${orderView == 'admin'}"><div class="table-wrap"><table><thead><tr><th>Mã đơn</th><th>Người mua / người bán</th><th>Trạng thái</th><th>Tổng tiền</th><th>Thời điểm</th></tr></thead><tbody><c:forEach items="${orders}" var="o"><tr><td><a class="table-title" href="<c:url value='${orderBase}/detail'><c:param name='id' value='${o.id}' /></c:url>"><c:out value="${o.order_code}" /></a></td><td><c:out value="${o.buyer_name_snapshot}" /><br><small><c:out value="${o.seller_name_snapshot}" /></small></td><td><span class="badge" data-status="${o.status}">${labels[o.status]}</span><span class="badge" data-status="${o.payment_status}">${labels[o.payment_status]}</span></td><td><strong class="price"><fmt:formatNumber value="${o.grand_total}" maxFractionDigits="0" /> ₫</strong></td><td><small><c:out value="${o.created_at}" /></small></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><div class="order-grid"><c:forEach items="${orders}" var="o"><article class="order-card"><h2><a href="<c:url value='${orderBase}/detail'><c:param name='id' value='${o.id}' /></c:url>">Đơn <c:out value="${o.order_code}" /></a></h2><p>Người mua: <c:out value="${o.buyer_name_snapshot}" /> · Người bán: <c:out value="${o.seller_name_snapshot}" /></p><p><span class="badge" data-status="${o.status}">${labels[o.status]}</span> <span class="badge" data-status="${o.payment_status}">${labels[o.payment_status]}</span></p><strong class="price"><fmt:formatNumber value="${o.grand_total}" maxFractionDigits="0" /> đ</strong><p><small><c:out value="${o.created_at}" /></small></p></article></c:forEach></div>
</c:otherwise></c:choose>
</section><%@ include file="../layouts/shop-end.jspf" %>
