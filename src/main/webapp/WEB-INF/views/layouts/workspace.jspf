<%@ page pageEncoding="UTF-8" %>
<aside class="workspace-nav" aria-label="${adminArea ? 'Điều hướng quản trị' : 'Điều hướng tài khoản'}"><p class="eyebrow">${adminArea ? 'Quản trị nền tảng' : 'Không gian của bạn'}</p>
<c:choose><c:when test="${adminArea}"><a href="<c:url value='/admin' />" ${pagePath == '/admin' ? 'aria-current="page"' : ''}>Tổng quan</a><a href="<c:url value='/admin/verifications?status=PENDING' />" ${fn:startsWith(pagePath, '/admin/verifications') ? 'aria-current="page"' : ''}>Hồ sơ người bán</a><a href="<c:url value='/admin/products' />" ${fn:startsWith(pagePath, '/admin/products') ? 'aria-current="page"' : ''}>Quản lý sản phẩm</a><a href="<c:url value='/admin/products?status=PENDING' />">Tin chờ duyệt</a><a href="<c:url value='/admin/orders' />" ${fn:startsWith(pagePath, '/admin/orders') ? 'aria-current="page"' : ''}>Quản lý đơn hàng</a><a href="<c:url value='/admin/complaints' />" ${fn:startsWith(pagePath, '/admin/complaints') ? 'aria-current="page"' : ''}>Quản lý khiếu nại</a><a href="<c:url value='/admin/complaints?status=RECEIVED' />">Hồ sơ mới tiếp nhận</a></c:when><c:otherwise><a href="<c:url value='/account/profile' />" ${fn:startsWith(pagePath, '/account/') ? 'aria-current="page"' : ''}>Hồ sơ cá nhân</a><a href="<c:url value='/buyer/orders' />" ${fn:startsWith(pagePath, '/buyer/orders') or fn:startsWith(pagePath, '/buyer/reviews') ? 'aria-current="page"' : ''}>Đơn mua &amp; đánh giá</a><a href="<c:url value='/buyer/complaints' />" ${fn:startsWith(pagePath, '/buyer/complaints') ? 'aria-current="page"' : ''}>Khiếu nại của tôi</a><a href="<c:url value='/seller/verification' />" ${fn:startsWith(pagePath, '/seller/verification') ? 'aria-current="page"' : ''}>Xác minh người bán</a><a href="<c:url value='/seller/products' />" ${fn:startsWith(pagePath, '/seller/products') ? 'aria-current="page"' : ''}>Tin đăng của tôi</a><a href="<c:url value='/seller/orders' />" ${fn:startsWith(pagePath, '/seller/orders') ? 'aria-current="page"' : ''}>Đơn bán</a></c:otherwise></c:choose></aside>
