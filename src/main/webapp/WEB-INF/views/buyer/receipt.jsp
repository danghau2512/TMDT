<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layouts/shop-start.jspf" %>
<section class="receipt"><div class="success-icon"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg></div><p class="eyebrow">Cảm ơn bạn</p><h1>Đặt hàng thành công</h1><p>Các đơn đã được tách theo người bán. Với VNPAY Sandbox, hãy thanh toán riêng từng đơn bên dưới bằng thẻ thử nghiệm.</p><c:forEach var="order" items="${orders}"><c:url var="orderUrl" value="/buyer/orders/detail"><c:param name="id" value="${order.id}" /></c:url><div class="receipt-order"><a href="${orderUrl}">Đơn <c:out value="${order.order_code}" /></a><strong><fmt:formatNumber value="${order.grand_total}" pattern="#,##0" /> ₫</strong><span class="badge">${labels[order.method]}</span><c:if test="${order.method == 'VNPAY_SANDBOX' and order.payment_status == 'PENDING_CONFIRMATION' and (order.status == 'PENDING' or order.status == 'CONFIRMED')}"><form method="post" action="<c:url value='/payments/vnpay/create' />" data-payment-submit="Đang chuyển sang VNPAY…"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="orderId" value="${order.id}"><button>Thanh toán VNPAY</button></form></c:if></div></c:forEach><div class="actions"><a class="button" href="<c:url value='/buyer/orders' />">Theo dõi đơn mua</a><a href="<c:url value='/products' />">Tiếp tục mua sắm</a></div></section>
<%@ include file="../layouts/shop-end.jspf" %>
