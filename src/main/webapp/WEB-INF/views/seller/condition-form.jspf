<%@ page pageEncoding="UTF-8" %>
<div class="declaration-form"><h2 class="form-section-title">3. Tình trạng chi tiết</h2><p class="condition-note">Mô tả trung thực để người mua dễ quyết định. Có thể chọn “Không áp dụng” cho ngành hàng không phù hợp; để trống khi chưa cung cấp.</p>
<div class="form-row"><label>Ngoại hình<select name="appearance"><option value="">Chưa cung cấp</option><c:forTokens items="LIKE_NEW,LIGHT_SCRATCHES,WORN,NOT_APPLICABLE" delims="," var="code"><option value="${code}" ${(posted ? param.appearance : product.appearance_code) == code ? 'selected' : ''}>${conditionLabels[code]}</option></c:forTokens></select></label><label>Khả năng hoạt động<select name="operation"><option value="">Chưa cung cấp</option><c:forTokens items="NORMAL,FAULTY,NEEDS_REPAIR,NOT_APPLICABLE" delims="," var="code"><option value="${code}" ${(posted ? param.operation : product.operation_code) == code ? 'selected' : ''}>${conditionLabels[code]}</option></c:forTokens></select></label></div>
<label>Lỗi hoặc khuyết điểm đã biết<textarea name="defects" maxlength="1000" rows="3" placeholder="Ví dụ: trầy nhẹ ở góc trái, pin còn khoảng 80%..."><c:out value="${posted ? param.defects : product.known_defects}" /></textarea></label>
<label>Lịch sử sửa chữa<select name="repair"><option value="">Chưa cung cấp</option><c:forTokens items="NEVER,REPAIRED,UNKNOWN,NOT_APPLICABLE" delims="," var="code"><option value="${code}" ${(posted ? param.repair : product.repair_code) == code ? 'selected' : ''}>${conditionLabels[code]}</option></c:forTokens></select></label>
<div class="form-row"><label>Chi tiết sửa chữa / thay linh kiện<textarea name="repairDetails" maxlength="1000" rows="3"><c:out value="${posted ? param.repairDetails : product.repair_details}" /></textarea></label><label>Phụ kiện đi kèm<textarea name="accessories" maxlength="1000" rows="3" placeholder="Ví dụ: sạc, hộp, sách hướng dẫn"><c:out value="${posted ? param.accessories : product.accessories}" /></textarea></label></div></div>
