<%@ page pageEncoding="UTF-8" %>
<%@ include file="../layouts/shop-start.jspf" %>
<div class="section-heading"><h1><c:out value="${adminMode ? 'Quản lý sản phẩm' : 'Sản phẩm của tôi'}" /></h1><a class="button" href="<c:url value='${manageBase}/new' />">+ Đăng sản phẩm</a></div>
<form method="get" class="filter-bar"><label>Trạng thái duyệt<select name="status"><option value="">Tất cả</option><option value="PENDING" ${param.status == 'PENDING' ? 'selected' : ''}>Chờ duyệt</option><option value="APPROVED" ${param.status == 'APPROVED' ? 'selected' : ''}>Đã duyệt</option><option value="REJECTED" ${param.status == 'REJECTED' ? 'selected' : ''}>Từ chối</option></select></label><button>Lọc</button></form>
<c:if test="${empty products}"><section>Chưa có tin. Đăng sản phẩm để bắt đầu bán.</section></c:if>
<div class="table-wrap"><table><thead><tr><th>Sản phẩm / người bán</th><th>Giá &amp; tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="p" items="${products}"><tr><td><c:url var="editUrl" value="${manageBase}/edit"><c:param name="id" value="${p.id}" /></c:url><a class="table-title" href="${editUrl}"><c:out value="${p.title}" /></a><p class="muted">Người bán: <c:out value="${p.seller_name}" /></p><c:if test="${p.moderation_status == 'REJECTED'}"><p class="error">Lý do từ chối: <c:out value="${p.rejection_reason}" /></p></c:if><a href="${editUrl}">Sửa tin / Điều chỉnh số lượng</a></td><td><strong class="price"><fmt:formatNumber value="${p.price}" pattern="#,##0" /> ₫</strong><p>Còn ${p.stock_quantity} sản phẩm</p></td><td><span class="badge" data-status="${p.visibility}">${labels[p.visibility]}</span><span class="badge" data-status="${p.moderation_status}">${p.moderation_status == 'PENDING' ? 'Chờ duyệt' : labels[p.moderation_status]}</span></td><td><form method="post" action="<c:url value='${manageBase}/action' />" class="account-form compact"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="id" value="${p.id}"><input type="hidden" name="listingVersion" value="${p.listing_version}"><c:if test="${currentUser.admin}"><label>Lý do<input name="reason" maxlength="500" required placeholder="Lý do duyệt, từ chối hoặc ẩn"></label></c:if><div class="actions"><button class="secondary" name="action" value="HIDE">Ẩn tin</button><c:if test="${adminMode && p.moderation_status == 'PENDING'}"><button name="action" value="APPROVE">Duyệt</button><button class="danger" name="action" value="REJECT">Từ chối</button></c:if></div></form></td></tr></c:forEach></tbody></table></div>
<%@ include file="../layouts/shop-end.jspf" %>
